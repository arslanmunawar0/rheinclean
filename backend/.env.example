# Copy to backend/.env. Placeholders only. Do not put a real password in git.

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./data/rheinclean.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_SECONDS=3600
ENVIRONMENT=development

# Used only by: python -m app.cli create-admin
ADMIN_EMAIL=admin@rheinclean.example
ADMIN_PASSWORD=replace-with-12-or-more-characters

# Used only by: python -m app.cli purge-enquiries
RETAIN_DAYS=365
